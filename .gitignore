# Environnements virtuels
.venv/
env/

# Données (GTFS, carroyage INSEE, BPE...) et résultats générés — volumineux,
# certains fichiers dépassent la limite de 100 Mo de GitHub. Non versionnés,
# cf. README.md.
data/*
output/

# Traces locales des pondérations BPE testées en direct dans app_2.py (cf.
# views/accessibilite_urbaine_2.py) — jamais commitées, jamais poussées sur
# HF, juste un historique local d'expérimentation.
data_appli_jeu_ponderation_equi/*

# Exception : cache des communes déjà géocodées par réseau (~1 Mo), utilisé
# comme decoupage_reference_path par construire_donnees_bpe() pour éviter de
# re-géocoder les arrêts déjà connus — utile d'avoir ce cache dès le premier
# déploiement (Streamlit Cloud, nouveau clone...).
!data/memory_csv_agglo/

# Exception : référence vacances scolaires/académies (quelques Ko, statique,
# cf. src/vacances_scolaires.py) — comme memory_csv_agglo ci-dessus, doit
# être disponible dès le premier déploiement sans dépendre du dataset HF.
!data/vacances_scolaires.csv
!data/departements_academies.csv

# Exception : journal des mises à jour GTFS détectées (cf.
# .github/workflows/rafraichir-gtfs.yml, scripts/rafraichir_gtfs.py
# --journal) — historique cumulatif, commité automatiquement par l'Action.
!data/journal_maj_gtfs.csv

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
